# CFS_BANDWIDTH —— 不推荐启用，单独成组便于隔离
#
# 它给 struct cfs_rq 尾部追加 runtime_enabled / runtime_remaining / throttled_*
# 等成员。struct cfs_rq 是**按值内嵌**在 struct rq 里的，所以 cfs_rq 变大
# 会把 struct rq 后续成员（rt_rq / dl_rq / clock 等）整体位移。
#
# 实测：33 个导出符号 CRC 变化，涉及 32 个 .ko，其中 sched-walt.ko(25)、
# lenovohyperSched.ko(9) 是高通/联想的调度器模块——它们直接按偏移读
# struct rq 字段。这里若用 #ifndef __GENKSYMS__ 把 CRC 修回去，闸门会变绿
# 但模块读到的是错位的字段，属于「静默错误」，比闸门变红更危险。
#
# 结论：想要 --cpus 限额就别要这个内核；两者不可兼得。
CONFIG_CFS_BANDWIDTH=y
