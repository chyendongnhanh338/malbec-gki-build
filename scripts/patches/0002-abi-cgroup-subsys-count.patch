+/*
+ * ABI: the stock kernel for this device shipped with CONFIG_CGROUP_DEVICE=n
+ * and CONFIG_CGROUP_PIDS=n, so neither id existed.  Two things keep the
+ * modversions ABI identical:
+ *
+ * 1. They are listed LAST so every subsystem that already existed keeps its
+ *    stock numeric value in enum cgroup_subsys_id -- otherwise every id after
+ *    "memory" would shift and any consumer storing an id numerically would
+ *    silently misbehave.
+ * 2. They are hidden from genksyms.  genksyms hashes the *preprocessed
+ *    declaration text*: CGROUP_SUBSYS_COUNT is an enum constant, not a macro,
+ *    so it survives preprocessing as a bare token and the declarations
+ *    "subsys[CGROUP_SUBSYS_COUNT]" read identically either way -- but the
+ *    enum member list is hashed as well, and struct css_set / struct cgroup /
+ *    struct cgroup_root embed arrays sized from it.  Feeding genksyms the
+ *    stock member list keeps the CRC of every symbol whose type graph reaches
+ *    task_struct->cgroups (~1400 of them) byte-identical to the stock kernel.
+ */
+#ifndef __GENKSYMS__
+#if IS_ENABLED(CONFIG_CGROUP_DEVICE)
+SUBSYS(devices)
+#endif
+#if IS_ENABLED(CONFIG_CGROUP_PIDS)
+SUBSYS(pids)
+#endif
+#endif /* !__GENKSYMS__ */
+
 /*
  * DO NOT ADD ANY SUBSYSTEM WITHOUT EXPLICIT ACKS FROM CGROUP MAINTAINERS.
  */
